{
  "$schema": "https://opencode.ai/config.json",

  "plugin": [
    "superpowers@git+https://github.com/obra/superpowers.git"
  ],

  "default_agent": "harness",

  "instructions": ["AGENTS.md"],

  "permission": {
    "skill": {
      "*": "deny",

      "gsd-discuss-phase": "allow",
      "gsd-plan-phase": "allow",
      "gsd-execute-phase": "allow",
      "gsd-verify-work": "allow",
      "gsd-audit-milestone": "allow",
      "gsd-complete-milestone": "allow",

      "gstack-office-hours": "allow",
      "gstack-plan-ceo-review": "allow",
      "gstack-plan-eng-review": "allow",
      "gstack-plan-design-review": "allow",
      "gstack-autoplan": "allow",
      "gstack-review": "allow",
      "gstack-codex": "allow",
      "gstack-browse": "allow",
      "gstack-ship": "allow",
      "gstack-retro": "allow",
      "gstack-learn": "allow",
      "gstack-freeze": "allow",
      "gstack-guard": "allow",
      "gstack-careful": "allow",

      "brainstorming": "allow",
      "writing-plans": "allow",
      "executing-plans": "allow",
      "subagent-driven-development": "allow",
      "test-driven-development": "allow",
      "using-git-worktrees": "allow",
      "systematic-debugging": "allow",
      "requesting-code-review": "allow",
      "receiving-code-review": "allow",
      "verification-before-completion": "allow",
      "finishing-a-development-branch": "allow"
    },

    "task": {
      "*": "deny",

      "gsd-phase-researcher": "allow",
      "gsd-planner": "allow",
      "gsd-pattern-mapper": "allow",
      "gsd-codebase-mapper": "allow",

      "gsd-executor": "allow",
      "gsd-debugger": "allow",
      "gsd-code-fixer": "allow",

      "gsd-verifier": "allow",
      "gsd-code-reviewer": "allow",
      "gsd-eval-auditor": "allow",
      "gsd-security-auditor": "allow"
    },

    "edit": "allow",
    "bash": {
      "git push --force*": "deny",
      "git reset --hard *": "deny",
      "rm -rf *": "deny",
      "*": "allow"
    }
  }
}
