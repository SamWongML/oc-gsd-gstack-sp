#!/usr/bin/env bash
#
# harness — opencode-harness CLI
#
# Subcommands:
#   install / update     install or refresh all three frameworks (idempotent)
#   init [size]          initialize harness in current project (mini|small|medium|large)
#   doctor               verify install and configuration
#   status               show what's installed and where
#   uninstall            remove the harness (preserves your projects)
#   version              print version
#   help                 show usage

set -euo pipefail

VERSION="0.1.0"
HARNESS_DIR="${HARNESS_HOME:-$HOME/.config/opencode-harness}"
SHARE="$HARNESS_DIR/share"
OPENCODE_DIR="$HOME/.config/opencode"

# ---------- pretty printing ----------
if [[ -t 1 ]]; then
  BOLD=$'\033[1m'; DIM=$'\033[2m'; RESET=$'\033[0m'
  GREEN=$'\033[32m'; YELLOW=$'\033[33m'; RED=$'\033[31m'; BLUE=$'\033[34m'
else
  BOLD=""; DIM=""; RESET=""; GREEN=""; YELLOW=""; RED=""; BLUE=""
fi
step() { printf "%s==>%s %s\n" "$BLUE$BOLD" "$RESET" "$*"; }
ok()   { printf "%s✓%s %s\n"   "$GREEN" "$RESET" "$*"; }
warn() { printf "%s!%s %s\n"   "$YELLOW" "$RESET" "$*"; }
fail() { printf "%s✗%s %s\n"   "$RED" "$RESET" "$*" >&2; exit 1; }
hdr()  { printf "\n%s%s%s\n"   "$BOLD" "$*" "$RESET"; }

require() {
  command -v "$1" >/dev/null 2>&1 || fail "Required command not found: $1. Run: harness install"
}

# ---------- subcommands ----------

cmd_help() {
  cat <<EOF
${BOLD}harness${RESET} — opencode-harness CLI v$VERSION

Usage: harness <command> [args]

${BOLD}Commands:${RESET}
  install                Install or update everything (idempotent)
  update                 Alias for 'install'
  init [size]            Initialize harness in current project
                         size: mini | small | medium | large (default: medium)
  doctor                 Verify install, run health checks
  self-test              Validate plugin shape, legs.json, hook contract, project leg
  status                 Show what's installed and where
  uninstall              Remove the harness (with confirmation)
  version                Print version
  help                   Show this help

${BOLD}Examples:${RESET}
  harness install                ${DIM}# first install or refresh after a few weeks${RESET}
  cd my-project && harness init medium   ${DIM}# new project${RESET}
  harness doctor                 ${DIM}# something feels off?${RESET}

Project repo: https://github.com/YOUR_USER/opencode-harness
EOF
}

cmd_version() { echo "$VERSION"; }

# ---------------------------------------------------------------- install/update
cmd_install() {
  hdr "Installing opencode-harness ($VERSION)"

  require git; require node; require jq
  command -v opencode >/dev/null 2>&1 || fail "opencode not found. Install: brew install opencode"

  mkdir -p "$OPENCODE_DIR"/{agents,plugin,skills}

  # 1. GSD --minimal (6 core skills, ~6 subagents)
  step "Installing GSD (minimal)"
  # The official installer is idempotent and accepts these flags.
  npx --yes get-shit-done-cc@latest --opencode --global --minimal >/dev/null
  ok "GSD installed/refreshed (minimal: 6 skills)"

  # 2. gstack with --prefix for namespacing
  local gstack_dir="$OPENCODE_DIR/skills/gstack"
  step "Installing gstack (namespaced)"
  if [[ -d "$gstack_dir/.git" ]]; then
    git -C "$gstack_dir" fetch --quiet --depth 1 origin main
    git -C "$gstack_dir" reset --hard --quiet origin/main
  else
    rm -rf "$gstack_dir"
    git clone --quiet --single-branch --depth 1 \
      https://github.com/garrytan/gstack.git "$gstack_dir"
  fi
  (cd "$gstack_dir" && ./setup --host opencode --prefix >/dev/null 2>&1) \
    || warn "gstack setup returned non-zero — install may still be usable"
  ok "gstack installed/refreshed (commands prefixed as /gstack-*)"

  # 3. Copy harness plugins to opencode plugin dir
  step "Installing harness plugins"
  cp -f "$SHARE/plugin/harness-state.ts" "$OPENCODE_DIR/plugin/"
  cp -f "$SHARE/plugin/harness-guard.ts" "$OPENCODE_DIR/plugin/"
  ok "Harness plugins installed (state + guard)"

  # 3b. Copy legs.json — single source of truth for leg rules.
  # Plugins (Phase 02+) read this at module-load via dirname(import.meta.url).
  # Today the guard still uses its hardcoded LEG_RULES; shipping the file now
  # so installs in the field already have it when Phase 02 lands.
  step "Installing legs.json"
  if [[ ! -f "$SHARE/legs.json" ]]; then
    fail "Missing $SHARE/legs.json — harness install assets are incomplete."
  fi
  jq -e '.legs | has("decision") and has("context") and has("execution") and has("verification") and has("ship")' \
      "$SHARE/legs.json" >/dev/null \
    || fail "share/legs.json failed schema check (need legs: decision/context/execution/verification/ship)"
  cp -f "$SHARE/legs.json" "$OPENCODE_DIR/plugin/legs.json"
  ok "legs.json installed (single source of truth for 5 legs)"

  # 4. Copy primary agents
  step "Installing primary agents"
  for agent in harness decide build verify; do
    cp -f "$SHARE/agents/$agent.md" "$OPENCODE_DIR/agents/$agent.md"
  done
  ok "Agents installed: harness | decide | build | verify"

  # 5. Merge global opencode.json (idempotent)
  step "Merging ~/.config/opencode/opencode.json"
  local cfg="$OPENCODE_DIR/opencode.json"
  if [[ ! -f "$cfg" ]]; then
    cp "$SHARE/opencode.global.json" "$cfg"
  else
    # User-managed merge: harness keys overlay user keys, but user's other keys preserved.
    local tmp; tmp=$(mktemp)
    jq -s '.[0] * .[1]' "$cfg" "$SHARE/opencode.global.json" > "$tmp"
    mv "$tmp" "$cfg"
  fi
  ok "opencode.json updated (Superpowers plugin + permissions)"

  # 6. Global AGENTS.md
  step "Installing global AGENTS.md"
  cp -f "$SHARE/AGENTS.md" "$OPENCODE_DIR/AGENTS.md"
  ok "Global AGENTS.md installed"

  echo
  ok "${BOLD}Harness ready.${RESET}"
  echo
  echo "${BOLD}Next steps:${RESET}"
  echo "  ${DIM}# In any project directory:${RESET}"
  echo "  harness init"
  echo "  opencode    ${DIM}# press Tab to switch agents: harness | decide | build | verify${RESET}"
  echo
  echo "  ${DIM}# Verify health:${RESET}"
  echo "  harness doctor"
}

cmd_update() { cmd_install "$@"; }

# ---------------------------------------------------------------- init (project)
cmd_init() {
  local size="${1:-medium}"
  case "$size" in mini|small|medium|large) ;;
  *) fail "Invalid size: $size. Use mini | small | medium | large." ;;
  esac

  [[ -d .git || -f opencode.json ]] || warn "Not in a git repo — proceeding anyway."

  hdr "Initializing harness in $(pwd) (size: $size)"

  # .planning/HARNESS.md
  step "Creating .planning/HARNESS.md"
  mkdir -p .planning
  if [[ -f .planning/HARNESS.md ]]; then
    warn ".planning/HARNESS.md already exists — leaving it alone."
  else
    sed "s/__SIZE__/$size/g" "$SHARE/templates/HARNESS.template.md" > .planning/HARNESS.md
    ok ".planning/HARNESS.md created"
  fi

  # AGENTS.md (project-level)
  step "Creating project AGENTS.md"
  if [[ -f AGENTS.md ]]; then
    warn "AGENTS.md already exists — appending harness section if missing."
    if ! grep -q "<!-- opencode-harness -->" AGENTS.md; then
      printf '\n\n' >> AGENTS.md
      cat "$SHARE/templates/AGENTS.project.md" >> AGENTS.md
      ok "Harness section appended."
    else
      ok "Harness section already present."
    fi
  else
    cp "$SHARE/templates/AGENTS.project.md" AGENTS.md
    ok "AGENTS.md created"
  fi

  # opencode.json (project-level) — only if missing
  if [[ ! -f opencode.json ]]; then
    step "Creating project opencode.json"
    cp "$SHARE/templates/opencode.project.json" opencode.json
    ok "opencode.json created"
  else
    ok "opencode.json already present — left alone (project precedence wins)."
  fi

  # .gitignore additions
  if [[ -f .gitignore ]] && ! grep -q "^.planning/HARNESS.local" .gitignore; then
    echo ".planning/HARNESS.local.md" >> .gitignore
  fi

  echo
  ok "${BOLD}Project initialized.${RESET}"
  echo
  echo "${BOLD}Run:${RESET}"
  echo "  opencode"
  echo "  ${DIM}# Then ask normally — the router picks the right framework for the size.${RESET}"
}

# ---------------------------------------------------------------- doctor
cmd_doctor() {
  hdr "Running harness doctor"
  local errs=0
  local warns=0

  # opencode
  if command -v opencode >/dev/null 2>&1; then
    ok "opencode installed: $(opencode --version 2>/dev/null | head -n1)"
  else
    warn "opencode missing (run: brew install opencode)"; errs=$((errs+1))
  fi

  # node, git, jq
  for c in node git jq; do
    if command -v "$c" >/dev/null 2>&1; then
      ok "$c present"
    else
      warn "$c missing"; warns=$((warns+1))
    fi
  done

  # Harness assets
  if [[ -d "$SHARE" ]]; then
    ok "Harness assets at $HARNESS_DIR"
  else
    warn "Harness assets missing — run: harness install"; errs=$((errs+1))
  fi

  # GSD
  if [[ -d "$OPENCODE_DIR/skills" ]]; then
    local n=0
    for d in "$OPENCODE_DIR"/skills/gsd-*; do
      [[ -d "$d" ]] && n=$((n+1))
    done
    if [[ $n -gt 0 ]]; then
      ok "GSD: $n skills installed"
    else
      warn "GSD skills not found in $OPENCODE_DIR/skills — run: harness install"
      warns=$((warns+1))
    fi
  else
    warn "GSD skills not found in $OPENCODE_DIR/skills — run: harness install"
    warns=$((warns+1))
  fi

  # gstack
  if [[ -d "$OPENCODE_DIR/skills/gstack/.git" ]]; then
    local rev; rev=$(git -C "$OPENCODE_DIR/skills/gstack" rev-parse --short HEAD 2>/dev/null || echo unknown)
    ok "gstack: installed at rev $rev"
  else
    warn "gstack not installed — run: harness install"; warns=$((warns+1))
  fi

  # Superpowers plugin entry
  if [[ -f "$OPENCODE_DIR/opencode.json" ]] && \
     jq -e '.plugin // [] | map(tostring) | any(test("superpowers"))' \
        "$OPENCODE_DIR/opencode.json" >/dev/null 2>&1; then
    ok "Superpowers plugin: registered in opencode.json"
  else
    warn "Superpowers plugin not in opencode.json — run: harness install"
    warns=$((warns+1))
  fi

  # Harness primary agents
  for a in harness decide build verify; do
    if [[ -f "$OPENCODE_DIR/agents/$a.md" ]]; then
      ok "Agent: $a"
    else
      warn "Missing agent: $a — run: harness install"; warns=$((warns+1))
    fi
  done

  # Harness plugins
  for p in harness-state.ts harness-guard.ts; do
    if [[ -f "$OPENCODE_DIR/plugin/$p" ]]; then
      ok "Plugin: $p"
    else
      warn "Missing plugin: $p — run: harness install"; warns=$((warns+1))
    fi
  done

  # legs.json (single source of truth for leg rules)
  local legs="$OPENCODE_DIR/plugin/legs.json"
  if [[ -f "$legs" ]]; then
    if jq -e '.legs | has("decision") and has("context") and has("execution") and has("verification") and has("ship")' \
        "$legs" >/dev/null 2>&1; then
      local leg_count; leg_count=$(jq -r '.legs | keys | length' "$legs")
      ok "legs.json: $leg_count legs registered"
    else
      warn "legs.json present but missing one of decision/context/execution/verification/ship — run: harness install"
      warns=$((warns+1))
    fi
  else
    warn "Missing legs.json (~/.config/opencode/plugin/legs.json) — run: harness install"
    warns=$((warns+1))
  fi

  # Heartbeat (operator visibility — written by both plugins on every hook fire)
  local hb="$OPENCODE_DIR/.harness-heartbeat.json"
  if [[ -f "$hb" ]]; then
    local last_inj inj_count last_abort abort_count last_skill
    last_inj=$(jq -r '.lastInjection // "(never)"' "$hb" 2>/dev/null)
    inj_count=$(jq -r '.injectionCount // 0' "$hb" 2>/dev/null)
    last_abort=$(jq -r '.lastAbort // "(never)"' "$hb" 2>/dev/null)
    abort_count=$(jq -r '.abortCount // 0' "$hb" 2>/dev/null)
    last_skill=$(jq -r '.lastAbortedSkill // "—"' "$hb" 2>/dev/null)
    ok "Heartbeat: last injection $last_inj (count: $inj_count); last abort $last_abort (count: $abort_count, skill: $last_skill)"
  else
    warn "No heartbeat yet at $hb — run opencode once with the harness loaded."
    warns=$((warns+1))
  fi

  # Project-level (if in a project)
  if [[ -f .planning/HARNESS.md ]]; then
    local leg; leg=$(grep -E '^- \*\*Leg:\*\*' .planning/HARNESS.md | head -n1 | sed 's/.*: *//;s/ *$//')
    ok "Project: HARNESS.md present (current leg: ${leg:-unset})"
  else
    [[ -d .git ]] && warn "No .planning/HARNESS.md in this project — run: harness init"
  fi

  echo
  if [[ $errs -gt 0 ]]; then
    fail "$errs error(s), $warns warning(s)"
  elif [[ $warns -gt 0 ]]; then
    warn "$warns warning(s) — run: harness install"
    exit 0
  else
    ok "${BOLD}All checks passed.${RESET}"
  fi
}

# ---------------------------------------------------------------- status
cmd_status() {
  hdr "harness status"
  echo "Harness:    $HARNESS_DIR"
  if [[ -d "$HARNESS_DIR/.git" ]]; then
    echo "  rev:      $(git -C "$HARNESS_DIR" rev-parse --short HEAD)"
    echo "  branch:   $(git -C "$HARNESS_DIR" rev-parse --abbrev-ref HEAD)"
  fi
  echo "OpenCode:   $OPENCODE_DIR"
  if [[ -d "$OPENCODE_DIR/skills/gstack/.git" ]]; then
    echo "  gstack:   $(git -C "$OPENCODE_DIR/skills/gstack" rev-parse --short HEAD)"
  fi
  if [[ -d "$OPENCODE_DIR/skills" ]]; then
    local gsd_count=0
    for d in "$OPENCODE_DIR"/skills/gsd-*; do
      [[ -d "$d" ]] && gsd_count=$((gsd_count+1))
    done
    echo "  GSD:      $gsd_count skills"
  fi
  if [[ -f "$OPENCODE_DIR/opencode.json" ]]; then
    if jq -e '.plugin // [] | map(tostring) | any(test("superpowers"))' \
        "$OPENCODE_DIR/opencode.json" >/dev/null 2>&1; then
      echo "  Superpowers plugin registered"
    fi
  fi
  echo "Agents:"
  for a in harness decide build verify; do
    if [[ -f "$OPENCODE_DIR/agents/$a.md" ]]; then
      echo "  - $a"
    fi
  done
  echo "Plugins:"
  for p in harness-state.ts harness-guard.ts; do
    if [[ -f "$OPENCODE_DIR/plugin/$p" ]]; then
      echo "  - $p"
    fi
  done
  if [[ -f "$OPENCODE_DIR/plugin/legs.json" ]]; then
    local lc; lc=$(jq -r '.legs | keys | length' "$OPENCODE_DIR/plugin/legs.json" 2>/dev/null || echo "?")
    echo "  - legs.json ($lc legs)"
  fi
}

# ---------------------------------------------------------------- self-test
cmd_self_test() {
  hdr "Running harness self-test"
  local errs=0
  local warns=0

  # 1. Plugin files exist + have a default export.
  for p in harness-state.ts harness-guard.ts; do
    local f="$OPENCODE_DIR/plugin/$p"
    if [[ ! -f "$f" ]]; then
      warn "Plugin missing: $p — run: harness install"
      errs=$((errs+1))
      continue
    fi
    if grep -q '^export default' "$f"; then
      ok "Plugin: $p (default export present)"
    else
      warn "Plugin $p has no 'export default' — opencode will not load it"
      errs=$((errs+1))
    fi
  done

  # 2. legs.json parses + has the canonical 5 legs.
  local legs="$OPENCODE_DIR/plugin/legs.json"
  if [[ ! -f "$legs" ]]; then
    warn "legs.json missing at $legs — run: harness install"
    errs=$((errs+1))
  elif ! jq -e '.legs | has("decision") and has("context") and has("execution") and has("verification") and has("ship")' \
        "$legs" >/dev/null 2>&1; then
    warn "legs.json present but missing one of decision/context/execution/verification/ship"
    errs=$((errs+1))
  else
    # Each leg has allowedSkills + forbiddenSkills arrays
    local bad
    bad=$(jq -r '
      .legs
      | to_entries[]
      | select((.value.allowedSkills | type) != "array" or (.value.forbiddenSkills | type) != "array")
      | .key
    ' "$legs")
    if [[ -n "$bad" ]]; then
      warn "legs.json: legs missing allowedSkills/forbiddenSkills arrays: $(echo "$bad" | tr '\n' ' ')"
      errs=$((errs+1))
    else
      ok "legs.json: 5 legs, allowedSkills + forbiddenSkills arrays valid"
    fi
  fi

  # 3. opencode plugin SDK exposes the experimental.chat.system.transform hook
  #    we depend on. If opencode renames/removes it, harness-state silently
  #    becomes a no-op — warn loudly here so doctor surfaces it.
  local plugin_types="$OPENCODE_DIR/node_modules/@opencode-ai/plugin/dist/index.d.ts"
  if [[ -f "$plugin_types" ]]; then
    if grep -q '"experimental.chat.system.transform"' "$plugin_types" \
       || grep -q "experimental\.chat\.system\.transform" "$plugin_types"; then
      ok "Hook: experimental.chat.system.transform present in plugin types"
    else
      warn "Hook 'experimental.chat.system.transform' NOT found in plugin types — opencode may have renamed it. Layer 3 injection at risk."
      warns=$((warns+1))
    fi
  else
    warn "Cannot find $plugin_types — skipping hook contract check"
    warns=$((warns+1))
  fi

  # 4. If we're in a project, validate Leg field against legs.json keys.
  if [[ -f .planning/HARNESS.md && -f "$legs" ]]; then
    local leg
    leg=$(grep -E '^- \*\*Leg:\*\*' .planning/HARNESS.md | head -n1 | sed 's/.*: *//;s/ *$//' | tr '[:upper:]' '[:lower:]')
    if [[ -z "$leg" ]]; then
      warn "Project HARNESS.md has no Leg: field"
      warns=$((warns+1))
    elif jq -e --arg leg "$leg" '.legs | has($leg)' "$legs" >/dev/null 2>&1; then
      ok "Project: Leg '$leg' is registered in legs.json"
    else
      warn "Project: Leg '$leg' is NOT in legs.json — guard will fail open"
      warns=$((warns+1))
    fi
  fi

  echo
  if [[ $errs -gt 0 ]]; then
    fail "$errs error(s), $warns warning(s)"
  elif [[ $warns -gt 0 ]]; then
    warn "$warns warning(s)"
    exit 0
  else
    ok "${BOLD}Self-test passed.${RESET}"
  fi
}

# ---------------------------------------------------------------- uninstall
cmd_uninstall() {
  hdr "Uninstalling opencode-harness"
  echo "This will remove:"
  echo "  - $HARNESS_DIR"
  echo "  - $OPENCODE_DIR/agents/{harness,decide,build,verify}.md"
  echo "  - $OPENCODE_DIR/plugin/harness-{state,guard}.ts"
  echo "  - $OPENCODE_DIR/plugin/legs.json"
  echo "  - $OPENCODE_DIR/.harness-heartbeat.json"
  echo "  - $OPENCODE_DIR/skills/gstack"
  echo "  - GSD-installed agents/skills (gsd-*)"
  echo
  echo "${BOLD}Your projects' .planning/ directories will NOT be touched.${RESET}"
  echo
  read -r -p "Proceed? [y/N] " ans
  [[ "${ans:-}" =~ ^[Yy]$ ]] || { echo "Aborted."; exit 0; }

  step "Removing harness assets"
  rm -rf "$HARNESS_DIR"
  rm -f "$OPENCODE_DIR"/agents/{harness,decide,build,verify}.md
  rm -f "$OPENCODE_DIR"/plugin/harness-{state,guard}.ts
  rm -f "$OPENCODE_DIR/plugin/legs.json"
  rm -f "$OPENCODE_DIR/.harness-heartbeat.json" "$OPENCODE_DIR/.harness-heartbeat.json.tmp"
  rm -rf "$OPENCODE_DIR/skills/gstack"
  # Remove GSD-installed skills/agents starting with gsd-
  if [[ -d "$OPENCODE_DIR/skills" ]]; then
    find "$OPENCODE_DIR/skills" -maxdepth 1 -type d -name 'gsd-*' -exec rm -rf {} +
  fi
  if [[ -d "$OPENCODE_DIR/agents" ]]; then
    find "$OPENCODE_DIR/agents" -maxdepth 1 -type f -name 'gsd-*.md' -exec rm -f {} +
  fi

  # Remove brew-managed symlink if it exists
  for d in "$(brew --prefix 2>/dev/null)/bin" /usr/local/bin "$HOME/.local/bin"; do
    [[ -L "$d/harness" ]] && rm -f "$d/harness"
  done

  ok "Uninstalled. (You may want to ${BOLD}rm $OPENCODE_DIR/AGENTS.md${RESET} if it was harness-only.)"
}

# ---------- dispatcher ----------
case "${1:-help}" in
  install)            shift; cmd_install   "$@" ;;
  update)             shift; cmd_update    "$@" ;;
  init)               shift; cmd_init      "$@" ;;
  doctor)             shift; cmd_doctor    "$@" ;;
  self-test|selftest) shift; cmd_self_test "$@" ;;
  status)             shift; cmd_status    "$@" ;;
  uninstall)          shift; cmd_uninstall "$@" ;;
  version|-v|--version) cmd_version ;;
  help|-h|--help|"")  cmd_help ;;
  *) fail "Unknown command: $1. Try 'harness help'." ;;
esac
